{
    "name": "justinholtweb/craft-headcount",
    "description": "Full-featured membership plugin for Craft CMS with Stripe + PayPal integration, tiered access, content gating, drip content, and subscription management.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "stripe/stripe-php": "^13.0 || ^14.0 || ^15.0 || ^16.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\headcount\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\headcount\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite unit"
    },
    "extra": {
        "handle": "headcount",
        "name": "Headcount",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://craft-headcount.com/docs",
        "class": "justinholtweb\\headcount\\Headcount",
        "hasCpSettings": true,
        "hasCpSection": true
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
