<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <!-- Pure logic: models, formatting, validation. No database or running
             Craft application required. Runs after a plain `composer install`.

             The database/element-coupled suite (services, the Subscription
             element, webhooks) boots a real Craft application and is run by
             Codeception, not PHPUnit — see `codeception.yml`, tests/integration,
             and tests/README.md. -->
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>
