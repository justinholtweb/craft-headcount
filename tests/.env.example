# Integration-suite test database. These defaults target a standard DDEV
# environment (host "db"). The harness WIPES this database on every run, so it
# MUST be a throwaway DB — never point it at the dev "db" database.
# Copy to tests/.env before running:  cp tests/.env.example tests/.env
#
# The default ddev "db" user only has rights on the "db" database, so the
# dedicated "test" database uses root/root (ddev's root password is "root").
CRAFT_DB_DRIVER=mysql
CRAFT_DB_DSN=mysql:host=db;port=3306;dbname=test
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=root
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# Throwaway key for the test app only — not a secret.
CRAFT_SECURITY_KEY=headcount-test-key-0000000000000000

CRAFT_ENVIRONMENT=test
CRAFT_DEV_MODE=true
